html 
    head 
        title nweb Lab2 - Bad Authentication


        h1 Task 2 - Bad Authentication
        hr
        h2
            a(href='/' title='SQL inj') Task 1 - SQL injection
        hr

        h2
            form(action="temp" method="POST")
                label(for="sql_inj") Bad Authentification Vulnerability:
                input(type="checkbox" id="sql_inj" name="sql_inj" value="1" onchange="this.form.submit()" checked=sql_inj ==="1")


        hr


        if username
            h2 Welcome #{username}

            h3 Your location: #{location}
            h3 Your information: #{information}

            form(action="/logout" method="POST")
                button(type="submit") Logout

        else
            form(action="/login" method="POST")
                label(for="username") Username:
                input(type="text" name="username" id="username" required)
                br
                br
                label(for="Password") Password:
                input(type="password" name="password" id="password" required)
                br
                br
                button(type="submit") Login